@model ContactDetailsViewModel
@{
    ViewData["Title"] = "Contact details";
    ViewData["NotificationMessage"] = "Showing our current contact details.";
    ViewData["NotificationType"] = "info";
}
<h1>@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9"><a href="mailto:@Model.Email">@Model.Email</a></dd>

            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9"><a href="@Model.PhoneHref">@Model.Phone</a></dd>

            <dt class="col-sm-3">Business hours</dt>
            <dd class="col-sm-9 mb-0">@Model.BusinessHours</dd>
        </dl>
    </div>
</div>
