@{
    ViewData["Title"] = "Home";
    ViewData["NotificationMessage"] = "Welcome! Choose a section below to get started.";
    ViewData["NotificationType"] = "info"; // info | success | warning | danger
}

<div class="text-center mb-4">
    <h1 class="display-4">Home</h1>
    <p class="lead">Browse the contact details and the addresses on file from one place.</p>
</div>

<div class="row row-cols-1 row-cols-md-2 g-4">
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="card-title h5">Contact details</h2>
                <p class="card-text">See the name, email, and phone number on file.</p>
                <a class="btn btn-primary mt-auto align-self-start" asp-controller="Contact" asp-action="Index">View contact details</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="card-title h5">Addresses</h2>
                <p class="card-text">Review the list of addresses currently on file.</p>
                <a class="btn btn-primary mt-auto align-self-start" asp-controller="Addresses" asp-action="Index">View addresses</a>
            </div>
        </div>
    </div>
</div>
