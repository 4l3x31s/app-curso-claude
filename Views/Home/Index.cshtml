@using System.Globalization
@using app_curso_claude.Services
@model Summary
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Home";
    ViewData["NotificationMessage"] = "Welcome! Choose a section below to get started.";
    ViewData["NotificationType"] = "info"; // info | success | warning | danger
}

<div class="text-center mb-4">
    <h1 class="display-4">Home</h1>
    <p class="lead">Browse the contact details and the addresses on file from one place.</p>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4 mb-4">
    <div class="col">
        <div class="card h-100 text-center" data-summary="active-products">
            <div class="card-body">
                <h2 class="card-title h6 text-muted">Active products</h2>
                <p class="card-text display-6 mb-0">@Model.ActiveProducts.ToString("N0", CultureInfo.InvariantCulture)</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 text-center" data-summary="units-in-stock">
            <div class="card-body">
                <h2 class="card-title h6 text-muted">Units in stock</h2>
                <p class="card-text display-6 mb-0">@Model.UnitsInStock.ToString("N0", CultureInfo.InvariantCulture)</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 text-center" data-summary="inventory-value">
            <div class="card-body">
                <h2 class="card-title h6 text-muted">Inventory value</h2>
                <p class="card-text display-6 mb-0">@Model.InventoryValue.ToString("N2", CultureInfo.InvariantCulture)</p>
            </div>
        </div>
    </div>
</div>

<h2 class="h5">Latest purchases</h2>

@if (Model.LatestPurchases.Count == 0)
{
    <p class="text-muted">There are no purchases yet.</p>
}
else
{
    <div class="table-responsive mb-4">
        <table class="table table-striped table-hover align-middle">
            <caption class="visually-hidden">Latest purchases of all products, newest first</caption>
            <thead>
                <tr>
                    <th scope="col">Date</th>
                    <th scope="col">Product</th>
                    <th scope="col">Customer</th>
                    <th scope="col" class="text-end">Quantity</th>
                    <th scope="col" class="text-end">Unit price</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var purchase in Model.LatestPurchases)
                {
                    <tr data-purchase-id="@purchase.Id">
                        <td>@purchase.PurchasedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@purchase.Product.Sku - @purchase.Product.Name</td>
                        <td>@purchase.Customer.FirstName @purchase.Customer.LastName</td>
                        <td class="text-end">@purchase.Quantity</td>
                        <td class="text-end">@purchase.UnitPrice.ToString("F2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="row row-cols-1 row-cols-md-2 g-4">
    @* While the flag is off the page answers 404, so the card would be a dead link. *@
    @if (Configuration.GetValue<bool>(FeatureFlags.Contact))
    {
        <div class="col">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h2 class="card-title h5">Contact details</h2>
                    <p class="card-text">See the name, email, and phone number on file.</p>
                    <a class="btn btn-primary mt-auto align-self-start" asp-controller="Contact" asp-action="Index">View contact details</a>
                </div>
            </div>
        </div>
    }
    <div class="col">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="card-title h5">Addresses</h2>
                <p class="card-text">Review the list of addresses currently on file.</p>
                <a class="btn btn-primary mt-auto align-self-start" asp-controller="Addresses" asp-action="Index">View addresses</a>
            </div>
        </div>
    </div>
</div>
